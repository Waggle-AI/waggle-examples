# Server: wallet that receives x402 payments.
X402_PAY_TO=0xYourReceivingWalletAddress

# Server: testnet defaults.
X402_PRICE=$0.001
X402_NETWORK=eip155:84532
X402_FACILITATOR_URL=https://x402.org/facilitator

# Client: wallet that pays for the A2A request.
EVM_PRIVATE_KEY=0xYourBaseSepoliaPrivateKey

# Client/server URL.
AGENT_URL=http://localhost:4021
